{
 "allies": {
  "npc_einar": {
   "hearts": 6,
   "bonus": "shutters",
   "line": "Железные ставни на фонарную. Саботажникам придётся постараться."
  },
  "npc_hedda": {
   "hearts": 6,
   "bonus": "pier_guard",
   "line": "Я поставлю «Треску» у твоего причала. Ни одна лодка не пристанет."
  },
  "npc_magnus": {
   "hearts": 6,
   "bonus": "medic",
   "line": "В полночь я поднимусь к тебе с сумкой. И трезвый."
  },
  "npc_olaf": {
   "hearts": 6,
   "bonus": "telegraph",
   "line": "Я предупрежу «Королеву». Шесть минут без огня она выдержит."
  },
  "npc_liv": {
   "hearts": 6,
   "bonus": "light_water",
   "line": "Три склянки «Светлой воды». Науке нужен эксперимент."
  },
  "npc_knud": {
   "hearts": 6,
   "bonus": "barricade",
   "line": "Нижнюю дверь я заколочу так, что сам не открою."
  },
  "npc_ingrid": {
   "hearts": 6,
   "bonus": "hold_father",
   "line": "Я удержу отца дома до полуночи. Как — не спрашивай."
  },
  "npc_sigrid": {
   "hearts": 6,
   "bonus": "bell_warning",
   "line": "Колокол часовни скажет тебе, откуда идут."
  },
  "npc_tuve": {
   "hearts": 6,
   "bonus": "calm_sea",
   "line": "Я поговорю с морем. Оно меня слушает."
  },
  "npc_tora": {
   "hearts": 4,
   "bonus": "mechanism",
   "line": "Механизм заест — я рядом. Починю за вдох."
  },
  "npc_erland": {
   "hearts": 4,
   "bonus": "retreat_boat",
   "line": "Лодка для отступления будет у скал. Надеюсь, не понадобится."
  },
  "npc_kai": {
   "hearts": 4,
   "bonus": "kills_false_fire",
   "line": "Ложный огонь я погашу сам. Сорок лет ждал."
  },
  "npc_rud": {
   "hearts": 4,
   "bonus": "distracts_brother",
   "line": "Нута я отвлеку. Он мне брат, но не хозяин."
  },
  "npc_benedict": {
   "hearts": 4,
   "bonus": "blessing",
   "line": "Благословлю твой фонарь. Встану подальше от окна, но благословлю."
  }
 },
 "npc_options": [
  {
   "id": "liv_glass",
   "npc": "npc_liv",
   "label": "Попросить стекло иллюминатора",
   "when": "quest_state('q2_4_bell') == 'active' and not has_item('porthole_glass') and not flag('porthole_given')",
   "effects": [
    [
     "item",
     "porthole_glass",
     1
    ],
    [
     "flag",
     "porthole_given"
    ]
   ],
   "reply": "Держи. Везла через три моря — не разбей на одном заливе."
  },
  {
   "id": "kai_visit",
   "npc": "npc_kai",
   "label": "Оставить керосин или грог",
   "when": "quest_state('q2_7_hermit') == 'active'",
   "call": "visit_kai"
  },
  {
   "id": "ingrid_key",
   "npc": "npc_ingrid",
   "label": "Попросить ключ от сейфа",
   "when": "quest_state('q3_8_safe') == 'active' and hearts('npc_ingrid') >= 6 and not has_item('safe_key') and not flag('safe_opened')",
   "effects": [
    [
     "item",
     "safe_key",
     1
    ],
    [
     "flag",
     "safe_key_given"
    ]
   ],
   "reply": "Возьми. Я… я хочу знать, кто мой отец. Даже если ответ плохой."
  },
  {
   "id": "olaf_page",
   "npc": "npc_olaf",
   "label": "Спросить про коллекцию писем",
   "when": "hearts('npc_olaf') >= 6 and not page(17)",
   "effects": [
    [
     "page",
     17
    ]
   ],
   "reply": "Эту страницу Агата оставила мне. Про морзянку. Забирай — ей место в журнале."
  },
  {
   "id": "olaf_trade",
   "npc": "npc_olaf",
   "label": "Обменять 3 письма в бутылках на страницу",
   "when": "hearts('npc_olaf') < 6 and not page(17) and has_item('message_bottle', 3)",
   "effects": [
    [
     "take",
     "message_bottle",
     3
    ],
    [
     "page",
     17
    ]
   ],
   "reply": "Три письма! По рукам. Страница Агаты — твоя."
  },
  {
   "id": "margit_page",
   "npc": "npc_margit",
   "label": "Заглянуть в корзинку с пряжей",
   "when": "hearts('npc_margit') >= 4 and not page(18)",
   "effects": [
    [
     "page",
     18
    ]
   ],
   "reply": "Ой, это её схема свитера. А на обороте… «Прости за сковородку». Ах она!.."
  },
  {
   "id": "hedda_letter",
   "npc": "npc_hedda",
   "label": "Отдать письмо из бутылки",
   "when": "has_item('letter_hedda')",
   "effects": [
    [
     "take",
     "letter_hedda",
     1
    ],
    [
     "friendship",
     "npc_hedda",
     250
    ]
   ],
   "reply": "«…Огонь был ненастоящий». Кто-то видел. Кто-то знал. Спасибо тебе."
  },
  {
   "id": "margit_letter",
   "npc": "npc_margit",
   "label": "Отдать письмо из бутылки",
   "when": "has_item('letter_margit')",
   "effects": [
    [
     "take",
     "letter_margit",
     1
    ],
    [
     "friendship",
     "npc_margit",
     250
    ]
   ],
   "reply": "Сковородка! У него! Ах ты ж… (смеётся и плачет) Спасибо, золотко."
  },
  {
   "id": "jacques_customs",
   "npc": "npc_olaf",
   "label": "Сдать тайник Жака таможне",
   "when": "quest_state('g7_rum') == 'active'",
   "effects": [
    [
     "honor",
     5
    ],
    [
     "money",
     800
    ],
    [
     "step_quest",
     "jacques_cache",
     "customs"
    ]
   ],
   "reply": "Таможня благодарит. Премия — восемьсот. И не говори Жаку, что я смеялся."
  },
  {
   "id": "knud_twenty",
   "npc": "npc_knud",
   "label": "Попросить помочь вынести кости «Фортуны»",
   "when": "twenty_help('npc_knud')",
   "call": "twenty_help"
  },
  {
   "id": "einar_twenty",
   "npc": "npc_einar",
   "label": "Попросить помочь вынести кости «Фортуны»",
   "when": "twenty_help('npc_einar')",
   "call": "twenty_help"
  }
 ],
