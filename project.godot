; Engine configuration file.
; Saltlight / Солёный свет — Godot 4.4+

config_version=5

[application]

config/name="Солёный свет"
config/name_locale={"en":"Saltlight"}
config/description="Хроники смотрителя маяка"
config/version="0.2.0-m1-dev"
run/main_scene="res://scenes/main/boot.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/sprites/icon.png"

[autoload]

Events="*res://autoload/events.gd"
Data="*res://autoload/data.gd"
Game="*res://autoload/game.gd"
Clock="*res://autoload/clock.gd"
Weather="*res://autoload/weather.gd"
Save="*res://autoload/save.gd"
Night="*res://autoload/night.gd"
Inventory="*res://autoload/inventory.gd"
Economy="*res://autoload/economy.gd"
Skills="*res://autoload/skills.gd"
Knowledge="*res://autoload/knowledge.gd"
Relationships="*res://autoload/relationships.gd"
Quests="*res://autoload/quests.gd"
Dialogue="*res://autoload/dialogue.gd"
Cutscenes="*res://autoload/cutscenes.gd"
NPCs="*res://autoload/npcs.gd"
Lighthouse="*res://autoload/lighthouse.gd"
Graveyard="*res://autoload/graveyard.gd"
Sea="*res://autoload/sea.gd"
Farm="*res://autoload/farm.gd"
Animals="*res://autoload/animals.gd"
Crafting="*res://autoload/crafting.gd"
Collections="*res://autoload/collections.gd"
Achievements="*res://autoload/achievements.gd"
AudioMgr="*res://autoload/audio_mgr.gd"
Router="*res://autoload/router.gd"
Settings="*res://autoload/settings.gd"
Loc="*res://autoload/loc.gd"
Debug="*res://autoload/debug.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[physics]

common/physics_ticks_per_second=60

